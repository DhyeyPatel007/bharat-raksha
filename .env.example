# PHALANX — copy to .env.local, never commit real values

# PayPal Sandbox (server only — needed for live disputes, seeded demo works without them)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# LLM Provider Configuration (defaults to gemini; seeded demo works without any key)
# Supported providers: gemini | openai | grok | deepseek | kimi | groq | nvidia | custom
LLM_PROVIDER=gemini
# Optional model override (defaults: gemini-3.8-flash, gpt-4o-mini, grok-4, deepseek-chat, kimi-k2.5, llama-3.3-70b-versatile, nvidia/llama-3.1-nemotron-70b-instruct)
LLM_MODEL=

# Provider API Keys (configure the one matching LLM_PROVIDER, or use LLM_API_KEY)
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
# Key from build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=

# Custom / Universal OpenAI-compatible endpoint (used if LLM_PROVIDER=custom, or overrides)
LLM_BASE_URL=
LLM_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ==============================================================================
# PHALANX UPI — Autonomous Refund & Claim Adjudication Shield (India D2C)
# ==============================================================================

# Razorpay Test Mode (Must start with rzp_test_ — rzp_live_ is strictly blocked)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Shiprocket Telemetry (mock | live)
SHIPROCKET_MODE=mock
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BEARER_TOKEN=

# WhatsApp Cloud API (Meta Webhook + Outbound Receipts)
WHATSAPP_VERIFY_TOKEN=phalanx_webhook_verify_2026
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Supabase Postgres (Optional — fallback is deterministic in-memory store)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
